# ==============================================================================
# GMAIL SMTP CONFIGURATION (Nodemailer)
# ==============================================================================
# Use a dedicated Gmail sender account with a 16-character Google App Password.
# How to generate a Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 3. Create an app password named "PocketBalance"
# 4. Copy the generated 16-character code (without spaces) into SMTP_PASSWORD below.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Secret key used for HMAC-SHA256 OTP hashing
OTP_SECRET=pocketbalance-otp-secure-salt-2026

# Supabase database configuration (optional cloud sync)
SUPABASE_URL=https://taesrkcpqujhkwvfsmke.supabase.co
SUPABASE_KEY=

# GEMINI_API_KEY: Required for Gemini AI insights (if enabled)
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"
